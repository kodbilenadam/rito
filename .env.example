# Copy to .env and fill in your keys (never commit .env).
# Personal/production key from developer.riotgames.com
RIOT_API_KEY_TEST=RGAPI-your-dev-key

# Optional second key for load testing
RIOT_API_KEY_PROD=RGAPI-your-prod-key

# Optional RSO access token for /me and other RSO endpoints
RIOT_RSO_TOKEN=

# Optional RSO client credentials for the Rito::RSO flow
RIOT_RSO_CLIENT_ID=
RIOT_RSO_CLIENT_SECRET=
RIOT_RSO_CLIENT_ASSERTION=
RIOT_RSO_REDIRECT_URI=
